# Variables requeridas. Copia este archivo a .env y completa los valores.
# NUNCA subas .env al repositorio.

# Proveedor LLM: anthropic | openai | mock
LLM_PROVIDER=mock

# Clave del proveedor (solo se usa en el backend; nunca en el front ni en logs)
LLM_API_KEY=

# Modelo del proveedor
LLM_MODEL=

# URL base opcional para proveedores compatibles
LLM_BASE_URL=

# Límites de costo por sesión
MAX_ITERATIONS=25
MAX_TOKENS_PER_SESSION=200000

# Puerto del servidor HTTP
PORT=3000

# Raíz de datos (casos, repositorio, glosario). Por defecto la raíz del proyecto.
# PERIFERIA_DATA_ROOT=